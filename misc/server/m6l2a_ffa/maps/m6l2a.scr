farplane_near:
    level.farplane = 1600
    $world farplane level.farplane
end

farplane_far:
    level.farplane = 2400
    $world farplane level.farplane
end

piano:
    $pianospeaker playsound moh_piano
end

cello:
    $cellospeaker playsound moh_cello
end
